{
  "name": "alexgallery",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate-photo-process && next build && pnpm exec tsx scripts/normalize-static-export.ts && pnpm exec tsx scripts/secure-static-export.ts && pnpm prune-private-assets",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "prepare-photo-process": "tsx scripts/prepare-photo-process.ts",
    "preview": "wrangler pages dev --port 8788",
    "start": "pnpm preview",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm typecheck",
    "test": "tsx --test tests/**/*.test.ts",
    "e2e": "playwright test",
    "validate-photo-process": "tsx scripts/validate-photo-process.ts",
    "prune-private-assets": "tsx scripts/prune-private-assets.ts",
    "export": "pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deploy:pages": "pnpm run build && wrangler pages deploy --branch main"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-slot": "^1.5.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "next": "^16.4.3",
    "plaiceholder": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@plaiceholder/next": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "wrangler": "4.153.0"
  }
}
